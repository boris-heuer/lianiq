{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boris-heuer/lianiq/native_e2e/evidence/schema/native-evidence.v1.schema.json",
  "title": "lianiq-native-evidence/v1",
  "description": "Evidence receipt of one native Windows run (CAP-0174 contract section 7.1). Validated by native_e2e.evidence.model.validate, which supports exactly the keywords used here.",
  "type": "object",
  "required": [
    "schema",
    "capability",
    "work_item",
    "commit",
    "workflow_run",
    "environment",
    "rows",
    "redaction_scan",
    "human_signoffs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lianiq-native-evidence/v1" },
    "capability": { "type": ["string", "null"], "minLength": 1 },
    "work_item": { "type": ["string", "null"], "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflow_run": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "required": ["windows_build", "image", "python", "models_manifest_sha256", "audio"],
      "additionalProperties": false,
      "properties": {
        "windows_build": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "pattern": "^win11-native-e2e@\\S+$" },
        "python": { "type": "string", "minLength": 1 },
        "models_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "audio": { "const": "virtual (VB-Cable A)" }
      }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "redaction_scan": {
      "type": "object",
      "required": ["status", "pattern_classes", "files_scanned", "screens_masked"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["clean", "findings"] },
        "pattern_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "files_scanned": { "type": "integer", "minimum": 0 },
        "screens_masked": { "type": "integer", "minimum": 0 }
      }
    },
    "human_signoffs": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["pass", "fail", "blocked", "pending"] },
    "row": {
      "type": "object",
      "required": ["id", "acs", "method", "status", "checks", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^([SCET]-[0-9]{2}|SHOT)$" },
        "acs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^AC-[0-9]{2}$" }
        },
        "method": { "enum": ["automated-native", "automated-virtual-device", "manual"] },
        "status": { "$ref": "#/$defs/status" },
        "reason": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "result"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "result": { "$ref": "#/$defs/status" },
              "detail": { "type": "string" }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9._-]+)*$"
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  }
}
